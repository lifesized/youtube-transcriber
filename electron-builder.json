{
  "appId": "com.transcribed.app",
  "productName": "Transcriber",
  "publish": null,
  "asar": true,
  "asarUnpack": [
    "node_modules/better-sqlite3/**/*",
    "tools/**/*",
    "electron/resources/trayTemplate.png",
    "electron/resources/trayTemplate@2x.png"
  ],
  "files": [
    "electron/**/*",
    "!electron/resources/standalone/**",
    "!electron/resources/bin/**",
    "!electron/dmg/**",
    "tools/**/*",
    "lib/**/*.js",
    "node_modules/better-sqlite3/**/*",
    "package.json"
  ],
  "directories": {
    "buildResources": "electron/resources",
    "output": "dist-electron"
  },
  "extraResources": [
    {
      "from": "electron/resources/bin",
      "to": "bin",
      "filter": ["**/*"]
    },
    {
      "from": "electron/resources/standalone",
      "to": "standalone",
      "filter": ["**/*"]
    }
  ],
  "mac": {
    "target": {
      "target": "dmg",
      "arch": ["arm64"]
    },
    "category": "public.app-category.productivity",
    "entitlements": "electron/entitlements.mac.plist",
    "entitlementsInherit": "electron/entitlements.mac.plist",
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "identity": null,
    "type": "distribution",
    "electronLanguages": ["en"],
    "extraFiles": []
  },
  "dmg": {
    "title": "Transcriber",
    "background": "electron/dmg/background.png",
    "iconSize": 72,
    "iconTextSize": 12,
    "window": {
      "width": 620,
      "height": 440
    },
    "contents": [
      {
        "x": 310,
        "y": 157,
        "type": "file",
        "path": "electron/dmg/Install Transcriber.command",
        "name": "Install Transcriber.command"
      },
      {
        "x": 160,
        "y": 312,
        "type": "file"
      },
      {
        "x": 460,
        "y": 312,
        "type": "link",
        "path": "/Applications"
      }
    ]
  },
  "afterPack": "./electron/after-pack.js",
  "afterSign": "./electron/after-sign.js"
}
