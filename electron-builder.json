{
  "appId": "com.transcribed.app",
  "productName": "Transcriber",
  "publish": null,
  "asar": true,
  "asarUnpack": [
    "node_modules/better-sqlite3/**/*",
    "tools/**/*",
    "electron/resources/trayTemplate.png",
    "electron/resources/trayTemplate@2x.png",
    "electron/resources/trayStartingTemplate.png",
    "electron/resources/trayStartingTemplate@2x.png",
    "electron/resources/trayAlertTemplate.png",
    "electron/resources/trayAlertTemplate@2x.png"
  ],
  "files": [
    "electron/**/*",
    "!electron/resources/standalone/**",
    "!electron/resources/bin/**",
    "!electron/dmg/**",
    "tools/**/*",
    "lib/**/*.js",
    "extension/local-auth-headers.js",
    "package.json",
    "node_modules/better-sqlite3/**/*",
    "node_modules/bindings/**/*",
    "node_modules/file-uri-to-path/**/*"
  ],
  "beforeBuild": "./electron/before-build.js",
  "directories": {
    "buildResources": "electron/resources",
    "output": "dist-electron"
  },
  "extraResources": [
    {
      "from": "electron/resources/bin",
      "to": "bin",
      "filter": ["**/*"]
    },
    {
      "from": "electron/resources/standalone",
      "to": "standalone",
      "filter": ["**/*"]
    }
  ],
  "mac": {
    "icon": "electron/resources/icon.icns",
    "extendInfo": {
      "LSUIElement": true
    },
    "target": {
      "target": "dmg",
      "arch": ["arm64"]
    },
    "category": "public.app-category.productivity",
    "entitlements": "electron/entitlements.mac.plist",
    "entitlementsInherit": "electron/entitlements.mac.plist",
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "identity": null,
    "type": "distribution",
    "electronLanguages": ["en"],
    "extraFiles": []
  },
  "dmg": {
    "title": "Transcriber",
    "background": "electron/dmg/background.png",
    "iconSize": 128,
    "iconTextSize": 13,
    "window": {
      "width": 660,
      "height": 420
    },
    "contents": [
      {
        "x": 330,
        "y": 200,
        "type": "file",
        "path": "electron/dmg/Install Transcriber.command",
        "name": "Install Transcriber.command"
      },
      {
        "x": 330,
        "y": 560,
        "type": "file"
      }
    ]
  },
  "afterPack": "./electron/after-pack.js",
  "afterSign": "./electron/after-sign.js"
}
