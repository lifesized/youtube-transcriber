{
  "name": "youtube-transcriber",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "trustedDependencies": [
    "better-sqlite3"
  ],
  "overrides": {
    "better-sqlite3": "^12.10.0"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "node scripts/run-with-local-token.js next dev -p 19720 --hostname 127.0.0.1 --webpack",
    "build": "next build",
    "start": "node scripts/run-with-local-token.js next start -p 19720 --hostname 127.0.0.1",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "mcp:build": "cd mcp-server && npm run build",
    "mcp:config": "bash scripts/mcp-config.sh",
    "reset-data": "tsx scripts/reset-data.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "fresh": "tsx scripts/fresh.ts",
    "test:setup": "bash scripts/test-setup.sh && node --test tests/setup-verification.test.mjs",
    "install-native-host": "node scripts/install-native-host.js",
    "uninstall-native-host": "node scripts/install-native-host.js --remove",
    "build:ext": "node extension/build.js",
    "build:ext:dev": "node extension/build.js --dev",
    "build:ext:enterprise": "node extension/build-enterprise.js",
    "test:local-auth": "node --test tests/local-api-auth.test.mjs tools/native-host/get-local-token.test.mjs extension/local-auth-headers.test.js",
    "test:extension": "node --test extension/*.test.js",
    "test:summarize-auth": "node --test tests/summarize-no-client-apikey.test.mjs",
    "test:secrets": "node --test tests/secrets-at-rest.test.mjs",
    "test:provider-url": "node --test tests/provider-url-policy.test.mjs",
    "migrate:secrets": "tsx scripts/migrate-secrets.ts",
    "test:mcp-auth": "node --test tests/mcp-local-auth.test.mjs",
    "test:electron": "node --test tests/electron-smoke.test.mjs tests/apply-migrations.test.mjs tests/native-host-pair.test.mjs tests/local-api-auth.test.mjs tests/native-host-electron.test.mjs tests/native-host-unpair.test.mjs tests/electron-lows.test.mjs tests/assert-packaged-requires.test.mjs tests/dmg-install.test.mjs tests/prune-electron-payload.test.mjs",
    "test:cache": "tsx --test tests/transcript-cache-db.test.mjs",
    "test:llm": "tsx --test tests/summarize-llm.test.mjs && tsx --test tests/summarize-cache.test.mjs",
    "test:notion": "tsx --test tests/notion-save.test.mjs",
    "electron:dev": "NODE_ENV=development electron .",
    "electron:prepare": "node scripts/prepare-electron-standalone.js",
    "electron:build": "npm run build && npm run electron:prepare && electron-builder --mac --arm64",
    "electron:rebuild": "electron-rebuild --force"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.2.4",
    "framer-motion": "^12.34.0",
    "geist": "^1.7.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@electron/fuses": "^2.1.3",
    "@electron/rebuild": "^4.2.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "playwright": "^1.63.0",
    "postcss": "^8.5.6",
    "prisma": "^7.4.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.19.2",
    "typescript": "5.9.3"
  }
}
